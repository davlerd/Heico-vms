# Copy to `secrets.auto.tfvars` (git-ignored). Never commit real values.
# Alternatively export them: TF_VAR_netskope_api_token=... / TF_VAR_bootstrap_secrets='{"auth-key":"..."}'

# Only with netskope.portal_automation = true (legacy API flow)
# netskope_api_token = "REPLACE_WITH_NETSKOPE_REST_API_TOKEN"

# Gateway password set through cloud-init (console access; SSH password login only if netskope.ssh_password_auth = true)
# netskope_gateway_password = "REPLACE"

bootstrap_secrets = {
  # Panorama / license manager (`sw_fw_license`) auth key
  "auth-key" = "REPLACE"
  # SCM bootstrap instead:
  # "vm-series-auto-registration-pin-value" = "REPLACE"
  # "authcodes"                             = "REPLACE"
}
