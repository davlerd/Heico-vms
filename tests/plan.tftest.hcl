# Plan-level test with mocked providers (no AWS / Netskope credentials needed).
# Run with the example inputs:
#   terraform test -var-file=terraform.tfvars.example

mock_provider "aws" {
  mock_data "aws_availability_zones" {
    defaults = { names = ["us-west-2a", "us-west-2b", "us-west-2c"] }
  }
  mock_data "aws_caller_identity" {
    defaults = { account_id = "111122223333" }
  }
  mock_data "aws_partition" {
    defaults = { partition = "aws" }
  }
  mock_data "aws_kms_alias" {
    defaults = { target_key_arn = "arn:aws:kms:us-west-2:111122223333:key/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" }
  }
  mock_data "aws_ami" {
    defaults = { id = "ami-0123456789abcdef0", image_id = "ami-0123456789abcdef0" }
  }
}

mock_provider "netskopebwan" {}

# The policy JSON is generated by the provider (mocked here), the Cloud WAN module validates its shape.
override_data {
  target = data.aws_networkmanager_core_network_policy_document.this
  values = {
    json = "{\"version\":\"2021.12\",\"core-network-configuration\":{\"asn-ranges\":[\"64520-64525\"]},\"segments\":[{\"name\":\"workloads\"}]}"
  }
}

run "example_plans_cleanly" {
  command = plan

  assert {
    condition     = length(aws_networkmanager_vpc_attachment.this) == 1
    error_message = "The security VPC must be attached to Cloud WAN."
  }

  assert {
    condition     = length(module.vmseries) == 1
    error_message = "Exactly one VM-Series (no autoscaling) is expected."
  }

  assert {
    condition     = length(module.netskope_sdwan) == 1
    error_message = "The Netskope SD-WAN module must be planned."
  }
}

run "netskope_vpc_overlapping_security_vpc_is_rejected" {
  command = plan

  variables {
    netskope = {
      instance = { ami_id = "ami-0123456789abcdef0" }
      vpc = {
        cidr = "10.103.0.0/24" # same CIDR as the Palo Alto security VPC
        primary_gw_subnets = {
          ge1 = { subnet_cidr = "10.103.0.100/28" }
          ge2 = { subnet_cidr = "10.103.0.116/28" }
        }
      }
    }
  }

  expect_failures = [terraform_data.guardrails]
}

run "netskope_ha_plans_cleanly" {
  command = plan

  variables {
    netskope = {
      instance = { ami_id = "ami-0123456789abcdef0" }
      vpc = {
        cidr = "10.103.1.0/24"
        primary_gw_subnets = {
          ge1 = { subnet_cidr = "10.103.1.0/28" }
          ge2 = { subnet_cidr = "10.103.1.16/28" }
        }
        secondary_gw_subnets = {
          ge1 = { subnet_cidr = "10.103.1.128/28" }
          ge2 = { subnet_cidr = "10.103.1.144/28" }
        }
      }
      gateway = { ha_enabled = true }
    }
  }

  assert {
    condition     = length(module.netskope_sdwan) == 1
    error_message = "The Netskope module must be planned with HA enabled."
  }
}

run "netskope_disabled_skips_module" {
  command = plan

  variables {
    netskope = {
      enabled  = false
      instance = { ami_id = "ami-0123456789abcdef0" }
      vpc = {
        cidr               = "10.103.1.0/24"
        primary_gw_subnets = { ge1 = { subnet_cidr = "10.103.1.0/28" } }
      }
    }
  }

  assert {
    condition     = length(module.netskope_sdwan) == 0
    error_message = "netskope.enabled = false must skip the Netskope module."
  }
}

run "vpc_outside_address_space_is_rejected" {
  command = plan

  variables {
    address_space = "10.103.0.0/16"
    netskope = {
      instance = { ami_id = "ami-0123456789abcdef0" }
      vpc = {
        cidr = "10.50.0.0/24" # outside 10.103.0.0/16
        primary_gw_subnets = {
          ge1 = { subnet_cidr = "10.50.0.0/28" }
          ge2 = { subnet_cidr = "10.50.0.16/28" }
        }
      }
    }
  }

  expect_failures = [terraform_data.guardrails]
}

run "netskope_legacy_portal_automation_plans_cleanly" {
  command = plan

  variables {
    netskope = {
      portal_automation = true
      tenant            = { tenant_id = "0000", tenant_url = "https://example.infiot.net" }
      vpc = {
        cidr = "10.103.1.0/24"
        primary_gw_subnets = {
          ge1 = { subnet_cidr = "10.103.1.0/28" }
          ge2 = { subnet_cidr = "10.103.1.16/28" }
        }
      }
      gateway = { gateway_role = "hub" }
    }
  }

  assert {
    condition     = length(module.netskope_sdwan) == 1
    error_message = "The Netskope module must plan with portal automation enabled."
  }
}

run "console_mode_requires_ami_id" {
  command = plan

  variables {
    netskope = {
      vpc = {
        cidr               = "10.103.1.0/24"
        primary_gw_subnets = { ge1 = { subnet_cidr = "10.103.1.0/28" } }
      }
    }
  }

  expect_failures = [var.netskope]
}

run "tenant_url_path_is_ignored" {
  command = plan

  variables {
    netskope = {
      tenant = { tenant_id = "heicocorp", tenant_url = "https://heicocorp.infiot.net/bwan/" }
      vpc = {
        cidr = "10.103.1.0/24"
        primary_gw_subnets = {
          ge1 = { subnet_cidr = "10.103.1.0/28" }
          ge2 = { subnet_cidr = "10.103.1.16/28" }
        }
      }
      instance = { ami_id = "ami-0123456789abcdef0" }
    }
  }

  assert {
    condition     = local.netskope_api_url == "https://heicocorp.api.infiot.net"
    error_message = "The API URL must be built from scheme + host only."
  }
}

run "netskope_without_lan_interface_is_rejected" {
